# Keep the reproducible training source in the public repository while
# excluding local credentials, caches, generated logs, and nested Git data.
!training/
training/**/.git/
training/**/.git/**
training/**/.git_local_backup/
training/**/.git_local_backup/**
training/**/*.pyc
training/**/__pycache__/
training/**/*.log
training/**/.env
training/**/.env.*
training/**/checkpoints/
training/**/checkpoint*/
training/**/outputs/
training/**/runs/
training/**/wandb/
training/**/tensorboard/
training/**/saves/

# The training tree is source code and should remain publishable despite the
# repository-wide rules above. Keep only local state and generated artifacts out.
!training/**
training/**/.git/
training/**/.git/**
training/**/.git_local_backup/
training/**/.git_local_backup/**
training/**/*.pyc
training/**/__pycache__/
training/**/*.log
training/**/.env
training/**/.env.*
training/**/checkpoints/
training/**/checkpoint*/
training/**/outputs/
training/**/runs/
training/**/wandb/
training/**/tensorboard/
training/**/saves/

# Keep local tooling metadata, editor settings, and machine-specific state out
# of the public source tree, including beneath the training-tree allowlist.
